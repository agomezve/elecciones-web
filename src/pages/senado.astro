---
// Ruta: src/pages/senado.astro
// Guía del voto al Senado y enlaces a los candidatos de cada provincia.
import BaseLayout from '../layouts/BaseLayout.astro';
import CabeceraPagina from '../components/CabeceraPagina.astro';
import Faq from '../components/Faq.astro';
import Autor from '../components/Autor.astro';
import AdSlot from '../components/AdSlot.astro';
import Fuente from '../components/Fuente.astro';
import { COMUNIDADES, ELECCION, PROVINCIAS, SENADO, num } from '../lib/datos';

const elegidos = PROVINCIAS.reduce((t, p) => t + p.senado.reduce((u, s) => u + s.senadores, 0), 0);
const circs = Object.values(SENADO).flat();
const candidaturas = circs.reduce((t, c) => t + c.listas.length, 0);
const candidatos = circs.reduce((t, c) => t + c.listas.reduce((u, l) => u + l.candidatos.length, 0), 0);

const title = 'Cómo se vota al Senado el 29-N: cuántos candidatos marcar';
const heading = 'Cómo se vota al Senado el 29-N';
const description = `Hasta 3 cruces en una provincia, 2 o 1 en las islas, y puedes mezclar partidos. Cómo votar sin que sea nulo y los ${num(candidatos)} candidatos, provincia a provincia.`;

const reparto = [
  { d: 'Cada provincia de la península', s: '4', m: '3' },
  { d: 'Gran Canaria, Mallorca y Tenerife', s: '3', m: '2' },
  { d: 'Ceuta y Melilla', s: '2', m: '2' },
  { d: 'Ibiza, Formentera, Menorca, Fuerteventura, La Gomera, El Hierro, Lanzarote y La Palma', s: '1', m: '1' },
];

const preguntas = [
  { q: '¿Cuántos senadores se eligen el 29-N?', a: `${elegidos} por votación directa. Los parlamentos autonómicos designan a los demás: uno por comunidad y otro por cada millón de habitantes.` },
  { q: '¿Cuántas cruces puedo poner en la papeleta del Senado?', a: 'Hasta 3 en una provincia de la península, 2 en Gran Canaria, Mallorca, Tenerife, Ceuta y Melilla, y 1 en las demás islas.' },
  { q: '¿Puedo marcar candidatos de partidos distintos?', a: 'Sí. Se vota a personas, y pueden ser de candidaturas diferentes.' },
  { q: '¿Tengo que marcar a todos los que puedo?', a: 'No. El máximo es un límite: puedes marcar menos. Si no marcas a nadie, es voto en blanco.' },
  { q: '¿Qué hace nulo el voto al Senado?', a: 'Marcar más nombres de los permitidos, añadir, tachar o cambiar nombres, escribir cualquier leyenda o usar una papeleta o un sobre que no sean los oficiales.' },
  { q: '¿De qué color es la papeleta del Senado?', a: 'Sepia. La del Congreso es blanca.' },
  { q: '¿Por qué Formentera elige ahora su propio senador?', a: 'Lo cambió la Ley Orgánica 2/2026, de 30 de junio. Antes Ibiza y Formentera compartían uno. Por eso se eligen 209 senadores directamente y no 208.' },
];
---

<BaseLayout title={title} heading={heading} description={description} breadcrumbs={[{ name: 'Senado' }]}>
  <CabeceraPagina titulo={heading} breadcrumbs={[{ name: 'Senado' }]} etiqueta="Guía práctica">
    <p>Aquí no se vota una lista cerrada: <strong>marcas personas con una cruz</strong>, y pueden ser de partidos distintos. Salen elegidos los más votados.</p>
  </CabeceraPagina>

  <div class="mx-auto max-w-6xl space-y-12 px-4 py-10 sm:px-6">
    <section class="grid grid-cols-2 gap-4 md:grid-cols-3">
      <div class="tarjeta"><p class="dato-valor">{elegidos}</p><p class="dato-nombre">senadores por votación directa</p></div>
      <div class="tarjeta"><p class="dato-valor">{num(candidaturas)}</p><p class="dato-nombre">candidaturas proclamadas</p></div>
      <div class="tarjeta"><p class="dato-valor">{num(candidatos)}</p><p class="dato-nombre">candidatos en toda España</p></div>
    </section>

    <section class="max-w-3xl">
      <h2 class="text-2xl font-bold tracking-tight">Cuántos candidatos puedes marcar</h2>
      <div class="mt-4 overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead><tr class="border-b border-slate-300"><th class="py-2 pr-4">Dónde votas</th><th class="py-2 pr-4">Senadores</th><th class="py-2">Puedes marcar</th></tr></thead>
          <tbody>{reparto.map((r) => <tr class="border-b border-slate-100"><td class="py-2 pr-4">{r.d}</td><td class="py-2 pr-4 font-semibold">{r.s}</td><td class="py-2 font-bold">{r.m}</td></tr>)}</tbody>
        </table>
      </div>
    </section>

    <section class="texto max-w-3xl">
      <h2>Cómo votar sin equivocarte</h2>
      <ul>
        <li>Coge la <strong>papeleta sepia</strong>. Trae a todos los candidatos de tu circunscripción.</li>
        <li>Pon una cruz junto a cada persona que quieras votar, <strong>sin pasarte del máximo</strong>.</li>
        <li>Métela en el sobre del Senado. El del Congreso es aparte.</li>
      </ul>
      <h2>Qué anula el voto y qué lo deja en blanco</h2>
      <p><strong>Es nulo</strong> si marcas más nombres de los permitidos, si añades, tachas o cambias nombres, si escribes algo en la papeleta o si usas un sobre o una papeleta que no sean los oficiales.</p>
      <p><strong>Es voto en blanco</strong> si dejas la papeleta sin ninguna cruz o si el sobre va vacío. <a href="/voto-en-blanco-nulo-abstencion">Qué cuenta cada uno</a>.</p>
      <h2>Cómo se reparten los escaños</h2>
      <p>Sin D'Hondt: se suman los votos de cada persona y salen elegidos los que más tienen, hasta cubrir los senadores de esa circunscripción. El reparto del Congreso funciona de otra forma: pruébalo en el <a href="/simulador-dhondt">simulador D'Hondt</a>.</p>
    </section>

    <AdSlot />

    <section>
      <h2 class="text-2xl font-bold tracking-tight">Candidatos al Senado de cada provincia</h2>
      <div class="mt-6 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          COMUNIDADES.map((c) => (
            <div>
              <h3 class="font-bold text-slate-900">{c.nombre}</h3>
              <ul class="mt-2 flex flex-wrap gap-2 text-sm">
                {c.provincias.map((p) => <li><a href={`/provincias/${p.slug}/senado`} class="inline-block rounded-full border border-slate-200 bg-white px-3 py-1.5 hover:border-indigo-300">{p.nombre}</a></li>)}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <Faq preguntas={preguntas} />
    <Fuente>
      Fuentes: Ley Orgánica 5/1985 del Régimen Electoral General (arts. 96, 161, 165 y 166), con la reforma de la Ley Orgánica 2/2026; Real Decreto 605/1999 (art. 4.2, color de las papeletas);
      candidaturas proclamadas, <a href={ELECCION.proclamadas.boe} rel="noopener" target="_blank">{ELECCION.proclamadas.nombre}</a>.
    </Fuente>
    <Autor />
  </div>
</BaseLayout>

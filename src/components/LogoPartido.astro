---
// Ruta: src/components/LogoPartido.astro
// Logotipo del partido (Wikimedia Commons) sobre fondo blanco; sin logotipo, sus siglas en su color.
import type { Partido } from '../lib/partidos';

interface Props {
  partido: Partido;
  class?: string;
}
const { partido, class: clase = 'h-14 w-28' } = Astro.props;
---

<span class:list={['flex items-center justify-center rounded-xl bg-white p-2', clase]}>
  {
    partido.logo ? (
      <img src={partido.logo} alt={`Logotipo de ${partido.nombre}`} loading="lazy" decoding="async" class="max-h-full max-w-full object-contain" />
    ) : (
      <span class="text-lg font-black tracking-tight" style={`color:${partido.color}`}>
        {partido.siglas}
      </span>
    )
  }
</span>
